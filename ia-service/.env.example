# Copier ce fichier en .env et adapter si besoin.

# Moteur OCR : "tesseract" (par défaut, fonctionne hors-ligne) ou "paddle"
OCR_ENGINE=tesseract
TESSERACT_LANG=fra+eng
# TESSERACT_CMD=/usr/bin/tesseract   # décommenter si tesseract n'est pas dans le PATH

# LLM (laisser vide tant qu'aucune clé n'est disponible côté équipe)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

LOG_LEVEL=INFO
